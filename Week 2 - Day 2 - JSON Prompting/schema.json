
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Motorcycle Expedition Itinerary",
  "description": "A structured day-by-day motorcycle expedition planning document.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "expedition_info": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 5
        },
        "total_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "start_location": {
          "type": "string",
          "minLength": 2
        },
        "end_location": {
          "type": "string",
          "minLength": 2
        },
        "travel_month": {
          "type": "string"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "currency": {
              "type": "string",
              "enum": ["INR"]
            },
            "minimum": {
              "type": "number",
              "minimum": 0
            },
            "maximum": {
              "type": "number",
              "minimum": 0
            },
            "estimated_total_inr": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "currency",
            "minimum",
            "maximum",
            "estimated_total_inr"
          ]
        },
        "primary_rider": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attire": {
              "type": "string"
            },
            "gear": {
              "type": "string"
            },
            "vehicle": {
              "type": "string"
            },
            "riding_experience": {
              "type": "string"
            }
          },
          "required": [
            "attire",
            "gear",
            "vehicle",
            "riding_experience"
          ]
        }
      },
      "required": [
        "title",
        "total_days",
        "start_location",
        "end_location",
        "travel_month",
        "budget",
        "primary_rider"
      ]
    },
    "itinerary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "from": {
            "type": "string",
            "minLength": 2
          },
          "to": {
            "type": "string",
            "minLength": 2
          },
          "distance_km": {
            "type": "number",
            "minimum": 0,
            "maximum": 1500
          },
          "riding_hours": {
            "type": "number",
            "minimum": 0,
            "maximum": 24
          },
          "terrain_type": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Highway",
                "Mountain Road",
                "Gravel Road",
                "Off Road",
                "Mixed Terrain",
                "City Road"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "altitude_m": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9000
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "fuel_stops": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accommodation": {
            "type": "string"
          },
          "overnight_location": {
            "type": "string"
          },
          "weather_notes": {
            "type": "string"
          },
          "safety_notes": {
            "type": "string"
          },
          "day_type": {
            "type": "string",
            "enum": [
              "Riding Day",
              "Rest Day",
              "Sightseeing Day",
              "Contingency Day"
            ]
          }
        },
        "required": [
          "day",
          "from",
          "to",
          "distance_km",
          "riding_hours",
          "terrain_type",
          "highlights",
          "day_type"
        ]
      }
    }
  },
  "required": [
    "expedition_info",
    "itinerary"
  ]
}
